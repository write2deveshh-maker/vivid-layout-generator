# ── Vivid Layout Generator — Environment Variables ─────────────────
# Copy this file to .env and fill your actual values
# This file IS safe to push to Git (no real keys here)

# ── Groq API ────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# ── Figma ───────────────────────────────────────────────────────────
FIGMA_TOKEN=your_figma_personal_access_token_here

# ── Hermes (Ollama) ─────────────────────────────────────────────────
# Install: ollama pull nous-hermes2 && ollama serve
# Set to false to disable (works fine without Ollama)
HERMES_ENABLED=true
HERMES_MODEL=nous-hermes2
OLLAMA_URL=http://localhost:11434/api/generate
